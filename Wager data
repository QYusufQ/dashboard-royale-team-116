import pandas as pd
import numpy as np

# 1. Load sessions data from 3_guests
df = pd.read_parquet("data/3_guests/sessions.parquet")
df.columns = df.columns.str.strip()

# 2. Filter for tracked carded play (valid player_id)
df_tracked = df[df["player_id"].notna() & (df["player_id"] != "")].copy()

# 3. Currency conversions (Cents -> USD)
df_tracked["wagered_usd"] = df_tracked["coin_in_cents"].astype(float) / 100.0
df_tracked["got_back_usd"] = df_tracked["payout_cents"].astype(float) / 100.0
df_tracked["theo_usd"] = df_tracked["theo_cents"].astype(float) / 100.0

# Net Casino Win per session (Wagered - Got Back)
df_tracked["net_win_usd"] = df_tracked["wagered_usd"] - df_tracked["got_back_usd"]

# 4. Aggregate by Player
player_summary = (
    df_tracked.groupby("player_id")
    .agg(
        total_wagered=("wagered_usd", "sum"),
        total_got_back=("got_back_usd", "sum"),
        net_casino_win=("net_win_usd", "sum"),
        total_theo=("theo_usd", "sum"),
        session_count=("player_id", "count")  # Safe session counter
    )
    .reset_index()
)

# ==========================================================
# OUTPUT 1: TRACKED PLAYER FINANCIAL TOTALS
# ==========================================================
total_players = player_summary["player_id"].nunique()
sum_wagered = player_summary["total_wagered"].sum()
sum_got_back = player_summary["total_got_back"].sum()
sum_net_win = player_summary["net_casino_win"].sum()
sum_theo = player_summary["total_theo"].sum()
overall_actual_hold = (sum_net_win / sum_wagered * 100) if sum_wagered > 0 else 0
overall_theo_hold = (sum_theo / sum_wagered * 100) if sum_wagered > 0 else 0

print("=== 1. TRACKED PLAYER FINANCIAL TOTALS ===")
print(f"Total Unique Tracked Players     : {total_players:,}")
print(f"Total Wagered (Coin-In)          : ${sum_wagered:,.2f}")
print(f"Total Got Back (Player Payouts)  : ${sum_got_back:,.2f}")
print(f"Net Casino Win (Player Loss)    : ${sum_net_win:,.2f}")
print(f"Total Theoretical Win (Theo)     : ${sum_theo:,.2f}")
print(f"Overall Actual Hold %            : {overall_actual_hold:.2f}%")
print(f"Overall Theoretical Hold %       : {overall_theo_hold:.2f}%\n")

# ==========================================================
# OUTPUT 2: CONCENTRATION (PARETO PERCENTILES & GINI)
# ==========================================================
player_summary = player_summary.sort_values("total_wagered", ascending=False).reset_index(drop=True)

player_summary["cum_wagered_pct"] = player_summary["total_wagered"].cumsum() / sum_wagered * 100
player_summary["cum_net_win_pct"] = player_summary["net_casino_win"].cumsum() / sum_net_win * 100

print("=== 2. PLAYER CONCENTRATION (PARETO SHARES) ===")
for p in [1, 5, 10, 20]:
    cutoff_idx = max(0, int(np.ceil(total_players * (p / 100.0))) - 1)
    w_share = player_summary.loc[cutoff_idx, "cum_wagered_pct"]
    win_share = player_summary.loc[cutoff_idx, "cum_net_win_pct"]
    print(f"Top {p:2d}% of Players ({cutoff_idx + 1:,} players) account for: {w_share:6.2f}% of Coin-In  |  {win_share:6.2f}% of Net Win")

# Gini Coefficient for Coin-In
wagers = np.sort(player_summary["total_wagered"].values)
n = len(wagers)
index = np.arange(1, n + 1)
gini = ((2 * np.sum(index * wagers)) / (n * np.sum(wagers))) - ((n + 1) / n)
print(f"\nCoin-In Gini Coefficient : {gini:.4f} (0 = Complete Equality, 1 = Max Concentration)\n")

# ==========================================================
# OUTPUT 3: DECILE BREAKDOWN (D10 = HIGHEST VOLUME SPENDERS)
# ==========================================================
player_summary["decile"] = pd.qcut(player_summary["total_wagered"].rank(method="first"), 10, labels=[f"D{i}" for i in range(1, 11)])

decile_summary = (
    player_summary.groupby("decile", observed=False)
    .agg(
        player_count=("player_id", "count"),
        total_coin_in=("total_wagered", "sum"),
        avg_coin_in_per_player=("total_wagered", "mean"),
        total_got_back=("total_got_back", "sum"),
        total_net_win=("net_casino_win", "sum")
    )
    .reset_index()
    .sort_values("decile", ascending=False)
)

decile_summary["coin_in_share_pct"] = (decile_summary["total_coin_in"] / sum_wagered) * 100
decile_summary["actual_hold_pct"] = (decile_summary["total_net_win"] / decile_summary["total_coin_in"]) * 100

print("=== 3. DECILE BREAKDOWN (D10 = HIGHEST VOLUME PLAYERS) ===")
print(decile_summary.to_string(index=False))